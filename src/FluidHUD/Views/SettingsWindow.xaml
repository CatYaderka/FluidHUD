<Window
    x:Class="FluidHUD.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="WindowRoot"
        Width="560"
        Height="650"
        Background="#24090F1C"
        RequestedTheme="Dark">

        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="78" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="0"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed">
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="9">
                    <Border Width="24" Height="24" Background="#255FCBFF" CornerRadius="8">
                        <FontIcon
                            Glyph="&#xE9D2;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="12"
                            Foreground="#FF8EDFFF" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="#DFFFFFFF"
                        Text="FluidHUD" />
                </StackPanel>
            </Grid>

            <Button
                Grid.Column="1"
                Width="32"
                Height="32"
                Margin="0,7,7,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="9"
                Click="OnCloseClicked"
                ToolTipService.ToolTip="Закрыть">
                <FontIcon
                    Glyph="&#xE8BB;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="11"
                    Foreground="#CFFFFFFF" />
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,15,30,24" Spacing="14">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="HeadingText"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Настроим FluidHUD" />
                    <TextBlock
                        x:Name="SubtitleText"
                        MaxWidth="480"
                        FontSize="13.5"
                        Foreground="#AFCBD5E4"
                        Text="Один хоткей — и текущий трек всегда под рукой. Настройки можно изменить позже."
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar
                    x:Name="ErrorInfoBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error"
                    Title="Не удалось применить настройки" />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Глобальная горячая клавиша" />
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="#91C5D0DF"
                                    Text="Работает, даже когда FluidHUD скрыт" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="1"
                                Glyph="&#xE765;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="18"
                                Foreground="#FF7BD8FF" />
                        </Grid>

                        <Button
                            x:Name="HotkeyButton"
                            MinHeight="48"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#1EFFFFFF"
                            BorderBrush="#36FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Click="OnHotkeyButtonClicked">
                            <TextBlock
                                x:Name="HotkeyText"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White" />
                        </Button>
                        <TextBlock
                            x:Name="HotkeyHintText"
                            FontSize="10.5"
                            Foreground="#7FC8D3E1"
                            Text="Совет: используйте Ctrl, Alt, Shift или Win, чтобы избежать случайных нажатий."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Время на экране" />
                                <TextBlock
                                    x:Name="DurationValueText"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="#FF7BD8FF" />
                            </Grid>
                            <Slider
                                x:Name="DurationSlider"
                                Minimum="2"
                                Maximum="12"
                                StepFrequency="0.5"
                                TickFrequency="1" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Прозрачность плеера" />
                                <TextBlock
                                    x:Name="OpacityValueText"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="#FF7BD8FF" />
                            </Grid>
                            <Slider
                                x:Name="OpacitySlider"
                                Minimum="0.20"
                                Maximum="1.00"
                                StepFrequency="0.01" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Скорость появления" />
                                <TextBlock
                                    x:Name="AnimationSpeedValueText"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="#FF7BD8FF" />
                            </Grid>
                            <Slider
                                x:Name="AnimationSpeedSlider"
                                Minimum="0.5"
                                Maximum="2.0"
                                StepFrequency="0.1"
                                TickFrequency="0.5" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Запуск вместе с Windows" />
                            <TextBlock
                                FontSize="11.5"
                                Foreground="#91C5D0DF"
                                Text="Только для текущего пользователя" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="StartupToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            OnContent="Вкл."
                            OffContent="Выкл." />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Позиция оверлея" />
                            <TextBlock
                                FontSize="11.5"
                                Foreground="#91C5D0DF"
                                Text="По центру активного экрана" />
                        </StackPanel>
                        <ComboBox
                            x:Name="PlacementComboBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0">
                            <ComboBoxItem Tag="BottomCenter" Content="Снизу" />
                            <ComboBoxItem Tag="TopCenter" Content="Сверху" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="30,13,30,17" Background="#4A080D18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="PreviewButton"
                    MinWidth="116"
                    Height="42"
                    Background="#17FFFFFF"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Click="OnPreviewClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                        <TextBlock Text="Предпросмотр" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ExitButton"
                    Width="42"
                    Height="42"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Click="OnExitClicked"
                    ToolTipService.ToolTip="Завершить FluidHUD">
                    <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                </Button>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="9">
                <Button
                    x:Name="CancelButton"
                    MinWidth="92"
                    Height="42"
                    Background="Transparent"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Click="OnCloseClicked"
                    Content="Отмена" />
                <Button
                    x:Name="SaveButton"
                    MinWidth="122"
                    Height="42"
                    Background="#FF2D9FE8"
                    BorderThickness="0"
                    CornerRadius="12"
                    Click="OnSaveClicked"
                    Content="Начать" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
