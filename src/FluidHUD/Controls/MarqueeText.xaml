<UserControl
    x:Class="FluidHUD.Controls.MarqueeText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Viewport" IsHitTestVisible="False">
        <!-- Ellipsis is used only while the text fits or before marquee starts. -->
        <TextBlock
            x:Name="StaticText"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            FontFamily="{x:Bind FontFamily, Mode=OneWay}"
            FontSize="{x:Bind FontSize, Mode=OneWay}"
            FontStyle="{x:Bind FontStyle, Mode=OneWay}"
            FontWeight="{x:Bind FontWeight, Mode=OneWay}"
            Foreground="{x:Bind Foreground, Mode=OneWay}"
            Text="{x:Bind Text, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />

        <!-- Two complete copies form a seamless loop. Moving text is never trimmed. -->
        <StackPanel
            x:Name="MarqueeStrip"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="MarqueeTransform" />
            </StackPanel.RenderTransform>

            <TextBlock
                x:Name="MovingText1"
                VerticalAlignment="Center"
                FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                FontSize="{x:Bind FontSize, Mode=OneWay}"
                FontStyle="{x:Bind FontStyle, Mode=OneWay}"
                FontWeight="{x:Bind FontWeight, Mode=OneWay}"
                Foreground="{x:Bind Foreground, Mode=OneWay}"
                Text="{x:Bind Text, Mode=OneWay}"
                TextTrimming="None"
                TextWrapping="NoWrap" />

            <Border x:Name="MarqueeGap" Width="42" />

            <TextBlock
                x:Name="MovingText2"
                VerticalAlignment="Center"
                FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                FontSize="{x:Bind FontSize, Mode=OneWay}"
                FontStyle="{x:Bind FontStyle, Mode=OneWay}"
                FontWeight="{x:Bind FontWeight, Mode=OneWay}"
                Foreground="{x:Bind Foreground, Mode=OneWay}"
                Text="{x:Bind Text, Mode=OneWay}"
                TextTrimming="None"
                TextWrapping="NoWrap" />
        </StackPanel>
    </Grid>
</UserControl>
